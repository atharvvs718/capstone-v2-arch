// CI/CD pipeline: GitHub -> Jenkins -> Docker image -> test -> (push) -> deploy
// For Jenkins running on WINDOWS with Docker Desktop (uses bat). Linux: replace bat with sh.
pipeline {
    agent any

    parameters {
        booleanParam(name: 'PUSH_TO_DOCKERHUB', defaultValue: false,
                     description: 'Push the image to Docker Hub (needs dockerhub-credentials in Jenkins)')
    }

    environment {
        IMAGE_NAME     = 'cicd-java-app'
        DOCKERHUB_USER = 'your-dockerhub-username'   // change if pushing
        APP_PORT       = '8082'                      // http://localhost:8082
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/atharvvs718/docker-cicd-app.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker version'
                bat "docker build -t %IMAGE_NAME%:%BUILD_NUMBER% -t %IMAGE_NAME%:latest ."
                bat 'docker images %IMAGE_NAME%'
            }
        }

        stage('Test') {
            steps {
                // start a temporary container from the new image and check it responds
                bat 'docker rm -f %IMAGE_NAME%-test 2>nul || exit /b 0'
                bat 'docker run -d --name %IMAGE_NAME%-test -p 9099:8080 %IMAGE_NAME%:%BUILD_NUMBER%'
                bat 'ping -n 6 127.0.0.1 > nul'
                bat 'curl -sf http://localhost:9099'
            }
            post {
                always {
                    bat 'docker rm -f %IMAGE_NAME%-test 2>nul || exit /b 0'
                }
            }
        }

        stage('Push to Docker Hub') {
            when { expression { params.PUSH_TO_DOCKERHUB } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials',
                                                  usernameVariable: 'DH_USER',
                                                  passwordVariable: 'DH_PASS')]) {
                    bat 'echo %DH_PASS%| docker login -u %DH_USER% --password-stdin'
                    bat 'docker tag %IMAGE_NAME%:%BUILD_NUMBER% %DH_USER%/%IMAGE_NAME%:%BUILD_NUMBER%'
                    bat 'docker push %DH_USER%/%IMAGE_NAME%:%BUILD_NUMBER%'
                    bat 'docker logout'
                }
            }
        }

        stage('Deploy') {
            steps {
                // replace the running container with the new version
                bat 'docker rm -f %IMAGE_NAME% 2>nul || exit /b 0'
                bat 'docker run -d --name %IMAGE_NAME% -p %APP_PORT%:8080 %IMAGE_NAME%:%BUILD_NUMBER%'
                bat 'docker ps --filter name=%IMAGE_NAME%'
            }
        }
    }

    post {
        success { echo "Deployed build #${env.BUILD_NUMBER} -> open http://localhost:${env.APP_PORT}" }
        failure { echo 'Pipeline failed - check the console output.' }
    }
}
