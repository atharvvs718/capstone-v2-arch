// Handout-style pipeline using the "Docker Pipeline" plugin syntax (docker.build / withRegistry).
// Needs: Docker Pipeline plugin + credentials id 'dockerhub-credentials' + your Docker Hub username below.
pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'your-dockerhub-username/cicd-java-app'
        REGISTRY_CREDENTIALS = 'dockerhub-credentials'
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/atharvvs718/docker-cicd-app.git'
            }
        }
        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${env.BUILD_NUMBER}")
                }
            }
        }
        stage('Push to Docker Hub') {
            steps {
                script {
                    docker.withRegistry('https://registry.hub.docker.com', "${REGISTRY_CREDENTIALS}") {
                        docker.image("${DOCKER_IMAGE}:${env.BUILD_NUMBER}").push()
                        docker.image("${DOCKER_IMAGE}:${env.BUILD_NUMBER}").push('latest')
                    }
                }
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploy stage - run the pushed image'
                bat "docker rm -f cicd-java-app 2>nul || exit /b 0"
                bat "docker run -d --name cicd-java-app -p 8082:8080 ${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
            }
        }
    }
}
