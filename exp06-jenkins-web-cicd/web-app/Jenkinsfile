// CI/CD pipeline for a static web app - Jenkins running on WINDOWS
pipeline {
    agent any

    environment {
        DEPLOY_DIR = 'C:\\deploy\\web-app'   // "web server" folder (use C:\\inetpub\\wwwroot if IIS is installed)
    }

    triggers {
        pollSCM('H/2 * * * *')              // auto-build when GitHub changes
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Cloning project from GitHub...'
                git branch: 'main', url: 'https://github.com/atharvvs718/cicd-web-app.git'
            }
        }
        stage('Build') {
            steps {
                echo 'Build step: listing files and creating build info'
                bat 'dir'
                bat 'echo Build #%BUILD_NUMBER% deployed on %DATE% %TIME% > build-info.txt'
            }
        }
        stage('Test') {
            steps {
                echo 'Test step: checking required files and HTML structure'
                bat 'if not exist index.html exit /b 1'
                bat 'if not exist style.css exit /b 1'
                bat 'if not exist script.js exit /b 1'
                bat 'findstr /C:"<html" index.html'
                bat 'findstr /C:"</html>" index.html'
                bat 'findstr /C:"<title>" index.html'
                echo 'All tests passed'
            }
        }
        stage('Deploy') {
            steps {
                echo "Deploying files to ${env.DEPLOY_DIR}"
                bat 'if not exist "%DEPLOY_DIR%" mkdir "%DEPLOY_DIR%"'
                bat 'copy /Y index.html "%DEPLOY_DIR%"'
                bat 'copy /Y style.css "%DEPLOY_DIR%"'
                bat 'copy /Y script.js "%DEPLOY_DIR%"'
                bat 'copy /Y build-info.txt "%DEPLOY_DIR%"'
                bat 'dir "%DEPLOY_DIR%"'
            }
        }
    }

    post {
        success { echo 'Pipeline finished successfully! Open C:\\deploy\\web-app\\index.html (or http://localhost:8000)' }
        failure { echo 'Pipeline failed! Check the console output.' }
    }
}
