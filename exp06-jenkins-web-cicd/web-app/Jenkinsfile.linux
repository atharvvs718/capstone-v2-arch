// Same pipeline for Jenkins running on LINUX (uses tidy for HTML validation)
pipeline {
    agent any
    environment {
        DEPLOY_DIR = '/var/www/html'
    }
    triggers {
        pollSCM('H/2 * * * *')
    }
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/atharvvs718/cicd-web-app.git'
            }
        }
        stage('Build') {
            steps {
                echo 'Build step: nothing to compile for a static site'
                sh 'ls -l'
            }
        }
        stage('Test') {
            steps {
                // tidy returns 1 for warnings, 2 for errors -> fail only on errors
                sh 'tidy -qe index.html || [ $? -eq 1 ]'
            }
        }
        stage('Deploy') {
            steps {
                sh 'cp index.html style.css script.js $DEPLOY_DIR/'
            }
        }
    }
    post {
        success { echo 'Deployed! Visit http://localhost/' }
        failure { echo 'Pipeline failed.' }
    }
}
